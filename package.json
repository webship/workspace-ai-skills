{
  "name": "@webship.co/workspace-ai-skills",
  "version": "1.0.10",
  "description": "The AI Skills workspace for Webship Workspace: the `ai-skills/` folder (type ai-items), its settings file, its 3 commands, its docs and its AI items (an agent, a skill, a command and a prompt, each in the folder of its kind), activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-ai-skills.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "ai-skills",
    "label": "AI Skills",
    "workspace": {
      "key": "ai-skills",
      "settingsTemplate": "config/workspace.ai-skills.settings.yml",
      "files": [
        "commands/cmd-tool-backup-skill.sh",
        "commands/cmd-tool-sync-skills.sh",
        "commands/cmd-tools-ai-items.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/ai-skills-keeper.md"
      ],
      "skills": [
        "ai/skills/ai-skills-workflow"
      ],
      "commands": [
        "ai/commands/ai-skills-install.md"
      ],
      "prompts": [
        "ai/prompts/ai-skills-write-a-new-skill.md"
      ]
    },
    "features": [
      "features/ai-skills.feature"
    ],
    "suggests": [
      "ai-agents",
      "ai-commands",
      "ai-prompts"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
